# RoleShift AI - environment configuration
# Copy this file to backend/.env (the backend reads ./.env or ../.env) and
# adjust values. NEVER commit real credentials - all values here are safe
# placeholders.
#
# PRODUCTION (Render) reference - set these in the Render dashboard
# "Environment" panel (never in render.yaml, never committed):
#
#   APP_ENV=production
#   LOG_LEVEL=INFO
#   MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
#   MONGODB_DATABASE=roleshift
#   CORS_ORIGINS=https://<your-project>.vercel.app
#   AI_PROVIDER=ollama_cloud
#   AI_MODEL=gpt-oss:120b
#   OLLAMA_API_KEY=<your-ollama-cloud-api-key>
#
# Optional production tweaks (only set when you need to change the default):
#   AI_TIMEOUT_SECONDS=90        # default 60; provider request timeout
#   AI_TEMPERATURE=0.3           # default 0.3
#   MONGODB_TIMEOUT_MS=5000      # default 5000; DB server-selection timeout

# --- Application ---
APP_ENV=development            # development | staging | production | test
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
APP_DEBUG=false

# --- MongoDB (recommended: MongoDB Atlas, nothing installed locally) ---
# Create a free cluster at https://www.mongodb.com/atlas, then use your
# connection string here, e.g.:
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
#
# Local development fallback (no Atlas):
# MONGODB_URL=mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=roleshift

# --- CORS ---
# Comma-separated list of allowed origins (no wildcard by default in production).
# Development uses the Vite dev-server origins; production must list the exact
# Vercel frontend origin, e.g. CORS_ORIGINS=https://<your-project>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (Ollama Cloud) ---
# AI_PROVIDER selects the provider: ollama_cloud | deepseek | none
AI_PROVIDER=ollama_cloud
AI_MODEL=gpt-oss:120b
# Server-side only. Never exposed to the browser, never logged.
# OLLAMA_API_KEY=<your-ollama-cloud-api-key>

# --- API ---
# API_V1_PREFIX=/api/v1
